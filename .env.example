# Red Team C2 Framework - Environment Configuration
# Copy this file to .env and update with your values

# ======================
# Database Configuration
# ======================
DATABASE_URL=postgres://c2user:c2password@localhost:5432/c2_database
POSTGRES_USER=c2user
POSTGRES_PASSWORD=c2password
POSTGRES_DB=c2_database

# ======================
# Teamserver Configuration
# ======================
SERVER_ADDR=0.0.0.0:8443
RUST_LOG=debug

# Encryption key (32 bytes hex-encoded)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ======================
# Controller Configuration
# ======================
C2_SERVER_URL=http://localhost:8443

# ======================
# SSL/TLS Configuration
# ======================
# Set to 'true' for production with valid certificates
TLS_ENABLED=false
TLS_CERT_PATH=/etc/c2/cert.pem
TLS_KEY_PATH=/etc/c2/key.pem

# ======================
# Operational Security
# ======================
# Maximum concurrent beacons
MAX_BEACONS=1000

# Beacon timeout (seconds)
BEACON_TIMEOUT=300

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ======================
# Advanced Configuration
# ======================
# DNS domain for covert channel
DNS_DOMAIN=c2.example.com

# Proxy URL (optional)
PROXY_URL=

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
